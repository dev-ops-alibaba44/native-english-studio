# Copy this file to .env.local and fill in the real values.
# .env.local is already in .gitignore — never commit real keys.

# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — Settings -> API -> service_role (secret!)
# Used by the Stripe webhook route (app/api/stripe/webhook/route.ts) to write
# billing data with no logged-in user session. Keep this out of version control.
SUPABASE_SERVICE_ROLE_KEY=

# --- Batch 6: Stripe billing ---
# Secret key: Stripe Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=

# Webhook signing secret: Stripe Dashboard -> Developers -> Webhooks -> your
# endpoint (https://yourdomain.com/api/stripe/webhook, or use `stripe listen`
# for local testing) -> Signing secret
STRIPE_WEBHOOK_SECRET=

# Price IDs: create these as Products/Prices in the Stripe Dashboard
# (Products -> Add product -> recurring, yearly billing period).
# Suggested starting prices, from Native_English_Financial_Model.xlsx:
#   License:        $2,000/year  (negotiable $1,500-$2,500 per agency)
#   Standard seat:  $150/year per student
#   Premium seat:   $275/year per student
STRIPE_PRICE_LICENSE=
STRIPE_PRICE_SEAT_STANDARD=
STRIPE_PRICE_SEAT_PREMIUM=

# --- Batch 27: direct-to-consumer (parent/individual) pricing ---
# Separate Price IDs from the agency seat prices above — create these as
# two new Products in Stripe Dashboard (recurring, annual), see README
# Batch 27 for exact steps.
# Batch 27 for exact steps.
STRIPE_PRICE_PARENT_SEAT_BASIC=
STRIPE_PRICE_PARENT_SEAT_ADVANCED=

# NEXT_PUBLIC_SITE_URL is intentionally NOT used anywhere as of Batch 26 —
# lib/site-url.ts derives the correct origin from each request's own
# headers instead (see that file's comment for why: NEXT_PUBLIC_ vars are
# baked in at build time, which kept causing invite/checkout links to
# point at localhost after being set correctly in Vercel but before the
# next deploy). No env var needed for this.

# --- Batch 9: Liveblocks (live collaborative editing) ---
# Sign up free at https://liveblocks.io -> create a project -> API keys.
# Only the SECRET key is needed — the app never exposes it to the browser;
# auth happens through app/api/liveblocks-auth/route.ts instead of a public
# key, so access can be checked against Supabase roles/RLS first.
LIVEBLOCKS_SECRET_KEY=

# --- Batch 9.4: AI essay feedback ---
# From console.anthropic.com -> API keys. You already have one (see
# Claude_API_key.txt in the project files) — paste its value here.
# Uses claude-haiku-4-5-20251001 (the cheapest current model) for feedback.
ANTHROPIC_API_KEY=

# --- Batch 13: super-admin AI usage/cost reporting ---
# A SEPARATE key from ANTHROPIC_API_KEY above — an Admin API key (starts
# with sk-ant-admin...), which can only read org-wide usage/cost data and
# cannot make chat completions. See the walkthrough in the message
# accompanying Batch 13 for exactly how to create one. Optional: the
# super-admin Usage page works fine without this, it just won't show real
# Anthropic spend until it's set.
ANTHROPIC_ADMIN_API_KEY=

# --- Batch 24: cleanup cron secret ---
# Any random string (e.g. generate one with `openssl rand -hex 32`).
# Vercel Cron automatically sends this back as an `Authorization: Bearer`
# header on every scheduled call to /api/cron/cleanup-pending-students —
# set the SAME value here and in Vercel's project environment variables.
# Without this set, the cleanup route refuses to run at all.
CRON_SECRET=
